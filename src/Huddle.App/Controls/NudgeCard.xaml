<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Huddle.Controls.NudgeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="10"
            Background="#0BFFFFFF"
            BorderBrush="#12FFFFFF"
            BorderThickness="1"
            Padding="13">
        <StackPanel Spacing="9">
            <!-- Scenario tag: colored dot + uppercase letter-spaced name -->
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse x:Name="ScenarioDot"
                         Width="7"
                         Height="7"
                         Fill="#C58BFF"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="ScenarioTagText"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="#6BFFFFFF"
                           CharacterSpacing="100"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Title — the hook -->
            <TextBlock x:Name="TitleText"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       LineHeight="20"
                       Foreground="#F0FFFFFF"
                       TextWrapping="Wrap"/>

            <!-- Body — the substance -->
            <TextBlock x:Name="BodyText"
                       FontSize="12.5"
                       LineHeight="20"
                       Foreground="#C8FFFFFF"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
