<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Huddle.Controls.MomentCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Huddle.Controls">

    <Border CornerRadius="10"
            Background="#0BFFFFFF"
            BorderBrush="#12FFFFFF"
            BorderThickness="1"
            Padding="13">
        <StackPanel Spacing="9">
            <TextBlock x:Name="SummaryText"
                       FontSize="13"
                       LineHeight="20"
                       Foreground="#F0FFFFFF"
                       TextWrapping="Wrap"/>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:AppTile x:Name="SourceTile" Grid.Column="0" Size="22"/>
                <TextBlock x:Name="WindowTitleText"
                           Grid.Column="1"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="#6BFFFFFF"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
