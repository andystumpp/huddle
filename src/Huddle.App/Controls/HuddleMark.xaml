<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Huddle.Controls.HuddleMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="28" Height="28">

    <!-- Three overlapping soft discs, mirroring panel.jsx HuddleMark. -->
    <Canvas Width="28" Height="28">
        <!-- "a" — accent (fluent default #60cdff lifted toward white) -->
        <Ellipse
            Canvas.Left="3.6"
            Canvas.Top="4.6"
            Width="12.8"
            Height="12.8"
            Fill="#7BD4FF"
            Opacity="0.95" />
        <!-- "b" — social violet -->
        <Ellipse
            Canvas.Left="11.6"
            Canvas.Top="4.6"
            Width="12.8"
            Height="12.8"
            Fill="#C58BFF"
            Opacity="0.85" />
        <!-- "c" — efficiency teal -->
        <Ellipse
            Canvas.Left="7.6"
            Canvas.Top="12.1"
            Width="12.8"
            Height="12.8"
            Fill="#54D2A6"
            Opacity="0.85" />
    </Canvas>
</UserControl>
