<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Huddle.Views.PeekPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Huddle.Controls">

    <Grid x:Name="RootClip"
          CornerRadius="13"
          BorderThickness="1"
          BorderBrush="#1AFFFFFF"
          Background="Transparent"
          RequestedTheme="Dark">

        <Grid.Resources>
            <!-- Palette (Fluent / aurora-ish defaults from the prototype) -->
            <Color x:Key="AccentColor">#FF60CDFF</Color>
            <Color x:Key="AccentColorSoft">#9960CDFF</Color>
            <SolidColorBrush x:Key="SocialBrush" Color="#C58BFF"/>
            <SolidColorBrush x:Key="EfficiencyBrush" Color="#54D2A6"/>
            <SolidColorBrush x:Key="T1" Color="#F0FFFFFF"/>
            <SolidColorBrush x:Key="T2" Color="#A8FFFFFF"/>
            <SolidColorBrush x:Key="T3" Color="#6BFFFFFF"/>
            <SolidColorBrush x:Key="PanelLine" Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="LookBarTrack" Color="#0FFFFFFF"/>
            <SolidColorBrush x:Key="HoverFill" Color="#17FFFFFF"/>
            <SolidColorBrush x:Key="ChipBg" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="ChipBgHover" Color="#17FFFFFF"/>
            <SolidColorBrush x:Key="ChipBgOn" Color="#20FFFFFF"/>
            <SolidColorBrush x:Key="ChipBorderOn" Color="#20FFFFFF"/>

            <!-- Header round buttons (pause, settings) -->
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource T2}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverFill}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChipBgOn}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filter chips -->
            <Style x:Key="Chip" TargetType="ToggleButton">
                <Setter Property="Height" Value="27"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Background" Value="{StaticResource ChipBg}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource T2}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChipBgHover}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChipBgOn}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChipBorderOn}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>      <!-- look-bar -->
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- filters -->
            <RowDefinition Height="*"/>      <!-- stream -->
        </Grid.RowDefinitions>

        <!-- ============== AURORA SHEEN ============== -->
        <!-- Two soft radial gradients layered above acrylic, mirroring the
             prototype's data-style aurora before pseudo-element. -->
        <Grid Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0.9">
            <!-- Top-right coral/pink wash, tied to the accent in aurora.
                 The prototype mixes accent at 26%; approximated below. -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.85,-0.1"
                                         GradientOrigin="0.85,-0.1"
                                         RadiusX="1.2"
                                         RadiusY="0.7"
                                         MappingMode="RelativeToBoundingBox">
                        <GradientStop Offset="0" Color="#5CFF7AA4"/>
                        <GradientStop Offset="0.6" Color="#00FF7AA4"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Bottom-left violet wash, tied to the social color. -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="-0.1,1.1"
                                         GradientOrigin="-0.1,1.1"
                                         RadiusX="1.2"
                                         RadiusY="0.8"
                                         MappingMode="RelativeToBoundingBox">
                        <GradientStop Offset="0" Color="#52C98BFF"/>
                        <GradientStop Offset="0.55" Color="#00C98BFF"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ============== LOOK BAR ============== -->
        <Border Grid.Row="0" Height="2" Background="{StaticResource LookBarTrack}" Canvas.ZIndex="2">
            <Border.Clip>
                <RectangleGeometry x:Name="LookBarClip" Rect="0,0,384,2"/>
            </Border.Clip>
            <Rectangle x:Name="LookBarFill" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{StaticResource AccentColorSoft}"/>
                        <GradientStop Offset="1" Color="{StaticResource AccentColor}"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LookBarScale" ScaleX="0"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Border>

        <!-- ============== HEADER ============== -->
        <Grid Grid.Row="1" Padding="15,14,14,12" Canvas.ZIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand -->
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <controls:HuddleMark Width="28" Height="28"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Huddle"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource T1}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,0" VerticalAlignment="Center">
                        <Grid Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse x:Name="WatchDotHalo"
                                     Width="6" Height="6"
                                     Fill="{StaticResource EfficiencyBrush}"
                                     Opacity="0.55"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="WatchDotHaloScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="WatchDot"
                                     Width="6" Height="6"
                                     Fill="{StaticResource EfficiencyBrush}"/>
                        </Grid>
                        <TextBlock x:Name="StatusText"
                                   Text="Watching · next look in 0:18"
                                   FontSize="12"
                                   Foreground="{StaticResource T2}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PauseBtn" Click="OnPauseClick" Style="{StaticResource HeaderButton}" ToolTipService.ToolTip="Pause">
                    <!-- pause icon: two rounded rects -->
                    <Grid Width="16" Height="16">
                        <Path x:Name="PauseIcon" Fill="{StaticResource T2}"
                              Data="M4,3 H6.6 A1,1 0 0 1 7.6,4 V12 A1,1 0 0 1 6.6,13 H4 A1,1 0 0 1 3,12 V4 A1,1 0 0 1 4,3 Z M9.4,3 H12 A1,1 0 0 1 13,4 V12 A1,1 0 0 1 12,13 H9.4 A1,1 0 0 1 8.4,12 V4 A1,1 0 0 1 9.4,3 Z"/>
                        <Path x:Name="PlayIcon" Visibility="Collapsed" Fill="{StaticResource T2}"
                              Data="M5,3.4 L13.65,7.1 A1,1 0 0 1 13.65,8.9 L5,12.6 A1,1 0 0 1 3.5,11.7 V4.3 A1,1 0 0 1 5,3.4 Z"/>
                    </Grid>
                </Button>
                <Button x:Name="SettingsBtn" Style="{StaticResource HeaderButton}" ToolTipService.ToolTip="Scenarios &amp; settings">
                    <Path Width="16" Height="16"
                          Stroke="{StaticResource T2}" StrokeThickness="1.4" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8 5.9 A2.1 2.1 0 1 0 8 10.1 A2.1 2.1 0 1 0 8 5.9 M8 1.4 V3 M8 13 V14.6 M14.6 8 H13 M3 8 H1.4 M12.7 3.3 L11.6 4.4 M4.4 11.6 L3.3 12.7 M12.7 12.7 L11.6 11.6 M4.4 4.4 L3.3 3.3"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============== FILTERS ============== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Padding="14,0,14,10" Canvas.ZIndex="2">
            <ToggleButton x:Name="ChipAll" Style="{StaticResource Chip}" IsChecked="True" Click="OnChipClick">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="All"/>
                    <TextBlock x:Name="CountAll" Text="0" Foreground="{StaticResource T3}" FontSize="11"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ChipSocial" Style="{StaticResource Chip}" Click="OnChipClick">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SocialBrush}"/>
                    <TextBlock Text="Social ideas"/>
                    <TextBlock x:Name="CountSocial" Text="0" Foreground="{StaticResource T3}" FontSize="11"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ChipEfficiency" Style="{StaticResource Chip}" Click="OnChipClick">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource EfficiencyBrush}"/>
                    <TextBlock Text="Efficiency"/>
                    <TextBlock x:Name="CountEfficiency" Text="0" Foreground="{StaticResource T3}" FontSize="11"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- ============== STREAM / EMPTY ============== -->
        <Grid Grid.Row="3" Canvas.ZIndex="2">
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="24,40,24,24"
                        Spacing="7">
                <Path Width="20" Height="20"
                      Fill="{StaticResource T2}"
                      Opacity="0.6"
                      HorizontalAlignment="Center"
                      Data="M10 1.5 L11.875 6.625 A1.875 1.875 0 0 0 13.038 7.788 L18.5 10 L13.038 12.213 A1.875 1.875 0 0 0 11.875 13.375 L10 18.5 L8.125 13.375 A1.875 1.875 0 0 0 6.963 12.213 L1.5 10 L6.963 7.788 A1.875 1.875 0 0 0 8.125 6.625 Z"/>
                <TextBlock Text="No nudges right now."
                           Foreground="{StaticResource T2}"
                           FontSize="13"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Huddle is watching — something useful will surface soon."
                           Foreground="{StaticResource T3}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="280"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
