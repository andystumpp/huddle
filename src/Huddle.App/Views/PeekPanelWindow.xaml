<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Huddle.Views.PeekPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Huddle.Controls">

    <Grid x:Name="RootClip" CornerRadius="13" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- panel-head: padding 14 14 12 15 (top right bottom left) -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="11"
            Padding="15,14,14,12">
            <controls:HuddleMark Width="28" Height="28" />
            <TextBlock
                Text="Huddle"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#F0FFFFFF" />
        </StackPanel>
    </Grid>
</Window>
