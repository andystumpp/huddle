<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Huddle.Views.PeekPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Huddle.Controls">

    <Grid x:Name="RootClip"
          CornerRadius="13"
          BorderThickness="1"
          BorderBrush="#1AFFFFFF"
          Background="Transparent"
          RequestedTheme="Dark">

        <Grid.Resources>
            <!-- Palette (Fluent / aurora-ish defaults from the prototype) -->
            <Color x:Key="AccentColor">#FF60CDFF</Color>
            <Color x:Key="AccentColorSoft">#9960CDFF</Color>
            <SolidColorBrush x:Key="SocialBrush" Color="#C58BFF"/>
            <SolidColorBrush x:Key="EfficiencyBrush" Color="#54D2A6"/>
            <SolidColorBrush x:Key="AuroraAccentBrush" Color="#FF7AA4"/>
            <SolidColorBrush x:Key="T1" Color="#F0FFFFFF"/>
            <SolidColorBrush x:Key="T2" Color="#A8FFFFFF"/>
            <SolidColorBrush x:Key="T3" Color="#6BFFFFFF"/>
            <SolidColorBrush x:Key="PanelLine" Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="LookBarTrack" Color="#0FFFFFFF"/>
            <SolidColorBrush x:Key="HoverFill" Color="#17FFFFFF"/>
            <SolidColorBrush x:Key="ChipBg" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="ChipBgHover" Color="#17FFFFFF"/>
            <SolidColorBrush x:Key="ChipBgOn" Color="#20FFFFFF"/>
            <SolidColorBrush x:Key="TabBg" Color="#10FFFFFF"/>
            <SolidColorBrush x:Key="TabBgHover" Color="#17FFFFFF"/>
            <SolidColorBrush x:Key="TabBgOn" Color="#26FFFFFF"/>

            <!-- Header round buttons (pause, settings) -->
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource T2}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverFill}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChipBgOn}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tabs (Nudges / Activity) — chunky pill, accent border on selected -->
            <Style x:Key="TabStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="14,0,14,0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource TabBg}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource T2}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="Presenter"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <!-- Left accent strip when checked -->
                                <Border x:Name="Accent"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Margin="0,8,0,8"
                                        CornerRadius="2"
                                        Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"
                                        Opacity="0"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabBgHover}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabBgOn}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource T1}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>      <!-- look-bar -->
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- tabs -->
            <RowDefinition Height="*"/>      <!-- content -->
        </Grid.RowDefinitions>

        <!-- ============== AURORA SHEEN ============== -->
        <!-- Two soft radial gradients layered above acrylic, mirroring the
             prototype's data-style aurora before pseudo-element. -->
        <Grid Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0.9">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.85,-0.1"
                                         GradientOrigin="0.85,-0.1"
                                         RadiusX="1.2"
                                         RadiusY="0.7"
                                         MappingMode="RelativeToBoundingBox">
                        <GradientStop Offset="0" Color="#5CFF7AA4"/>
                        <GradientStop Offset="0.6" Color="#00FF7AA4"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="-0.1,1.1"
                                         GradientOrigin="-0.1,1.1"
                                         RadiusX="1.2"
                                         RadiusY="0.8"
                                         MappingMode="RelativeToBoundingBox">
                        <GradientStop Offset="0" Color="#52C98BFF"/>
                        <GradientStop Offset="0.55" Color="#00C98BFF"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ============== LOOK BAR ============== -->
        <Border Grid.Row="0" Height="2" Background="{StaticResource LookBarTrack}" Canvas.ZIndex="2">
            <Border.Clip>
                <RectangleGeometry x:Name="LookBarClip" Rect="0,0,384,2"/>
            </Border.Clip>
            <Rectangle x:Name="LookBarFill" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{StaticResource AccentColorSoft}"/>
                        <GradientStop Offset="1" Color="{StaticResource AccentColor}"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LookBarScale" ScaleX="0"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Border>

        <!-- ============== HEADER ============== -->
        <Grid Grid.Row="1" Padding="15,14,14,12" Canvas.ZIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand -->
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <controls:HuddleMark Width="28" Height="28"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Huddle"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource T1}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,0" VerticalAlignment="Center">
                        <Grid Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse x:Name="WatchDotHalo"
                                     Width="6" Height="6"
                                     Fill="{StaticResource EfficiencyBrush}"
                                     Opacity="0.55"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="WatchDotHaloScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="WatchDot"
                                     Width="6" Height="6"
                                     Fill="{StaticResource EfficiencyBrush}"/>
                        </Grid>
                        <TextBlock x:Name="StatusText"
                                   Text="Watching · next look in 0:18"
                                   FontSize="12"
                                   Foreground="{StaticResource T2}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PauseBtn" Click="OnPauseClick" Style="{StaticResource HeaderButton}" ToolTipService.ToolTip="Pause">
                    <Grid Width="16" Height="16">
                        <Path x:Name="PauseIcon" Fill="{StaticResource T2}"
                              Data="M4,3 H6.6 A1,1 0 0 1 7.6,4 V12 A1,1 0 0 1 6.6,13 H4 A1,1 0 0 1 3,12 V4 A1,1 0 0 1 4,3 Z M9.4,3 H12 A1,1 0 0 1 13,4 V12 A1,1 0 0 1 12,13 H9.4 A1,1 0 0 1 8.4,12 V4 A1,1 0 0 1 9.4,3 Z"/>
                        <Path x:Name="PlayIcon" Visibility="Collapsed" Fill="{StaticResource T2}"
                              Data="M5,3.4 L13.65,7.1 A1,1 0 0 1 13.65,8.9 L5,12.6 A1,1 0 0 1 3.5,11.7 V4.3 A1,1 0 0 1 5,3.4 Z"/>
                    </Grid>
                </Button>
                <Button x:Name="SettingsBtn" Style="{StaticResource HeaderButton}" ToolTipService.ToolTip="Scenarios &amp; settings">
                    <Path Width="16" Height="16"
                          Stroke="{StaticResource T2}" StrokeThickness="1.4" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8 5.9 A2.1 2.1 0 1 0 8 10.1 A2.1 2.1 0 1 0 8 5.9 M8 1.4 V3 M8 13 V14.6 M14.6 8 H13 M3 8 H1.4 M12.7 3.3 L11.6 4.4 M4.4 11.6 L3.3 12.7 M12.7 12.7 L11.6 11.6 M4.4 4.4 L3.3 3.3"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============== TABS ============== -->
        <Grid Grid.Row="2" Padding="14,0,14,10" Canvas.ZIndex="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="TabNudges"
                          Grid.Column="0"
                          Style="{StaticResource TabStyle}"
                          BorderBrush="{StaticResource SocialBrush}"
                          Click="OnTabClick">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Lightbulb glyph -->
                    <Path Width="14" Height="14"
                          Fill="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Foreground}"
                          Data="M7 1.2 A4.4 4.4 0 0 0 4.2 9 V10.6 A0.8 0.8 0 0 0 5 11.4 H9 A0.8 0.8 0 0 0 9.8 10.6 V9 A4.4 4.4 0 0 0 7 1.2 Z M5.4 12.6 H8.6 V13.4 A0.6 0.6 0 0 1 8 14 H6 A0.6 0.6 0 0 1 5.4 13.4 Z"/>
                    <TextBlock Text="Nudges"/>
                    <TextBlock x:Name="CountNudges" Text="0" FontWeight="Normal" Opacity="0.65"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="TabActivity"
                          Grid.Column="1"
                          Style="{StaticResource TabStyle}"
                          BorderBrush="{StaticResource AuroraAccentBrush}"
                          Click="OnTabClick">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Pulse/activity glyph -->
                    <Path Width="14" Height="14"
                          Stroke="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Foreground}"
                          StrokeThickness="1.5"
                          Fill="Transparent"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M1.5 7 H4 L5.2 3.6 L7 11 L8.6 5.6 L9.6 7 H12.5"/>
                    <TextBlock Text="Activity"/>
                    <TextBlock x:Name="CountActivity" Text="0" FontWeight="Normal" Opacity="0.65"/>
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- ============== CONTENT AREA ============== -->
        <Grid Grid.Row="3" Canvas.ZIndex="2">

            <!-- Activity tab content: section header + pattern cards -->
            <Grid x:Name="ActivityContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section header: ⊕ PATTERNS DETECTED N        [status]  [snap button] -->
                <Grid Grid.Row="0" Padding="14,14,14,8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- circled-plus glyph -->
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse Stroke="{StaticResource T2}" StrokeThickness="1.2" Width="14" Height="14"/>
                            <Path Stroke="{StaticResource T2}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M7 4 V10 M4 7 H10"/>
                        </Grid>
                        <TextBlock Text="PATTERNS DETECTED"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource T2}"
                                   CharacterSpacing="80"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PatternCountText"
                                   Text="0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource T3}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Snapshot status text (right-aligned, briefly visible after a click) -->
                    <TextBlock x:Name="SnapshotStatusText"
                               Grid.Column="1"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EfficiencyBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>

                    <!-- Snapshot now button -->
                    <Button x:Name="SnapshotBtn"
                            Grid.Column="2"
                            Click="OnSnapshotClick"
                            Style="{StaticResource HeaderButton}"
                            ToolTipService.ToolTip="Snapshot now">
                        <Path Width="16" Height="16"
                              Stroke="{StaticResource T2}" StrokeThickness="1.4"
                              Fill="Transparent" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M2.6 4.6 H5.4 L6.4 3.2 H9.6 L10.6 4.6 H13.4 A1 1 0 0 1 14.4 5.6 V12.2 A1 1 0 0 1 13.4 13.2 H2.6 A1 1 0 0 1 1.6 12.2 V5.6 A1 1 0 0 1 2.6 4.6 Z M8 7.0 A2.4 2.4 0 1 0 8 11.8 A2.4 2.4 0 1 0 8 7.0"/>
                    </Button>
                </Grid>

                <!-- Pattern cards -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="14,0,14,14">
                    <ItemsRepeater x:Name="PatternsRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="9"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <controls:PatternCard Pattern="{Binding}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <!-- Nudges tab content: empty state -->
            <StackPanel x:Name="NudgesContent"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="24,40,24,24"
                        Spacing="7">
                <Path Width="20" Height="20"
                      Fill="{StaticResource T2}"
                      Opacity="0.6"
                      HorizontalAlignment="Center"
                      Data="M10 1.5 L11.875 6.625 A1.875 1.875 0 0 0 13.038 7.788 L18.5 10 L13.038 12.213 A1.875 1.875 0 0 0 11.875 13.375 L10 18.5 L8.125 13.375 A1.875 1.875 0 0 0 6.963 12.213 L1.5 10 L6.963 7.788 A1.875 1.875 0 0 0 8.125 6.625 Z"/>
                <TextBlock Text="No nudges right now."
                           Foreground="{StaticResource T2}"
                           FontSize="13"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Huddle is watching — something useful will surface soon."
                           Foreground="{StaticResource T3}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="280"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
